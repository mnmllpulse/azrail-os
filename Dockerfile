# AZRAIL — образ песочницы.
#
# БАЗА НЕ ПРОИЗВОЛЬНАЯ. Внутри образа работает HTTP-сервер, через который
# SDK разговаривает с контейнером. Обычный node:22-slim его не содержит, и
# песочница на нём молча не поднимется — поэтому базой обязан быть
# официальный образ Cloudflare.
#
# ВЕРСИЯ ЗАКРЕПЛЕНА И ОБЯЗАНА СОВПАДАТЬ с версией пакета @cloudflare/sandbox
# в package.json. SDK сверяет их при старте; расхождение ломает часть
# возможностей и пишет предупреждение в логи. Обновляя пакет — правь и эту
# строку.
#
# Вариант -python, а не голый: AZRAIL считает и разбирает данные, а python
# с numpy/pandas здесь уже стоит. Ставить их потом на каждом холодном
# старте — минуты на ровном месте.
FROM docker.io/cloudflare/sandbox:0.12.9-python

# Больше сюда не кладётся ничего. Базовый образ уже содержит node, bun,
# git, curl, jq и утилиты; каждый лишний слой — время старта на КАЖДОМ
# запуске песочницы и лишняя поверхность атаки.
