# Обязательно для сборки в CI.
#
# wrangler требует @cloudflare/workers-types v5, а agents/partyserver — v4.
# Оба нужны, конфликт не разрешается сам: обычный `npm install` падает с
# ERESOLVE, и Cloudflare Workers Builds не соберёт проект вообще — до кода
# дело даже не дойдёт.
#
# Всю разработку это обходилось флагом `npm install --legacy-peer-deps`,
# но CI запускает установку без флагов, поэтому настройка вынесена в файл.
legacy-peer-deps=true
