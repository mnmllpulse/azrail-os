# Dark Mnmll Pulse OS - Configuration

# --- SYSTEM ---
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0

# --- SECURITY ---
# URL of your app or '*' for any (CORS)
CORS_ORIGIN=*

# --- AI (GEMINI) ---
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- CLOUDFLARE INTEGRATION ---
# Your Cloudflare Account ID (Found on Dashboard)
CLOUDFLARE_ACCOUNT_ID=
# Your Cloudflare API Token (Created in My Profile -> API Tokens)
CLOUDFLARE_API_TOKEN=

# --- OPTIONAL: TELEGRAM BOTS ---
