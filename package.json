{
  "name": "azrail-pulse-unified",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --config wrangler.staging.json",
    "types": "wrangler types",
    "db:schema": "wrangler d1 execute azrail-db --remote --file=./schema.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "check": "npm run build:ui && npm run typecheck && npm test",
    "build:check": "wrangler deploy --dry-run --outdir .work/worker --containers-rollout=none",
    "build:check:staging": "wrangler deploy --dry-run --config wrangler.staging.json --outdir .work/staging-worker --containers-rollout=none",
    "db:security": "wrangler d1 execute azrail-db --remote --file=./migrations/004-security-hardening.sql",
    "db:migrate": "node scripts/migrate.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:ui": "node scripts/build-ultimate.mjs && node scripts/build-unified.mjs",
    "predeploy": "npm run build:ui",
    "build": "node scripts/build-unified.mjs",
    "provision": "node scripts/provision.mjs",
    "deploy:ci": "node scripts/deploy-ci.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@cloudflare/sandbox": "0.12.9",
    "agents": "^0.8.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.2",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240729.0",
    "@types/node": "^24.13.6",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.29.1"
    }
  }
}
