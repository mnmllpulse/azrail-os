name = "azrail-os-staging"
main = "src/index.ts"
compatibility_date = "2026-08-08"
compatibility_flags = ["nodejs_compat"]

[assets]
directory = "./public"
binding = "ASSETS"

[[durable_objects.bindings]]
name = "Orchestrator"
class_name = "Orchestrator"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["Orchestrator"]

# Create a dedicated staging database first, then paste its ID here.
[[d1_databases]]
binding = "AZRAIL_D1"
database_name = "azrail-db-staging"
database_id = "REPLACE_STAGING_D1_ID"

# Dedicated staging KV. Never reuse the production namespace ID.
[[kv_namespaces]]
binding = "AZRAIL_KV"
id = "REPLACE_STAGING_KV_ID"

# Dedicated staging bucket. It is private by default.
[[r2_buckets]]
binding = "AZRAIL_R2"
bucket_name = "azrail-artifacts-staging"

[ai]
binding = "AI"

[vars]
# Fail-safe staging defaults: no third-party paid routing.
AZRAIL_FORCE_FREE = "true"
AZRAIL_WORKERS_PLAN = "free"
AZRAIL_METERING = "observe"
AZRAIL_MISSION_BUDGET_USD = "0.25"
AZRAIL_WRITE_BUDGET = "1000"
AZRAIL_HOURLY_LIMIT = "20"
AZRAIL_MISSION_STALE_MINUTES = "20"

# Same-origin UI works with this sentinel. Replace after first deploy if a
# separate origin must call the staging API.
CORS_ORIGIN = "https://staging.invalid"

# Intentionally omitted in staging by default:
# AI_GATEWAY_ID
# GITHUB_TOKEN / GITHUB_REPO
# AZRAIL_SANDBOX / containers
# production cron triggers
