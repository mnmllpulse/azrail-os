name = "azrail-os-staging"
main = "src/index.ts"
compatibility_date = "2026-08-08"
compatibility_flags = ["nodejs_compat"]
workers_dev = true

[assets]
directory = "./public"
binding = "ASSETS"

[[durable_objects.bindings]]
name = "Orchestrator"
class_name = "Orchestrator"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["Orchestrator"]

# Create a dedicated staging D1 first. Never reuse the production ID.
[[d1_databases]]
binding = "AZRAIL_D1"
database_name = "azrail-db-staging"
database_id = "REPLACE_STAGING_D1_ID"

# Dedicated staging KV namespace.
[[kv_namespaces]]
binding = "AZRAIL_KV"
id = "REPLACE_STAGING_KV_ID"

# Dedicated staging R2 bucket.
[[r2_buckets]]
binding = "AZRAIL_R2"
bucket_name = "azrail-artifacts-staging"

[ai]
binding = "AI"

[vars]
# Safe baseline: staging cannot route to paid third-party models.
AZRAIL_FORCE_FREE = "true"
AZRAIL_WORKERS_PLAN = "free"
AZRAIL_METERING = "observe"
AZRAIL_MISSION_BUDGET_USD = "0.25"
AZRAIL_WRITE_BUDGET = "1000"
AZRAIL_HOURLY_LIMIT = "20"
AZRAIL_MISSION_STALE_MINUTES = "20"

# Same-origin Pulse UI does not need permissive CORS.
CORS_ORIGIN = "https://staging.invalid"

# Intentionally absent in baseline staging:
# AI_GATEWAY_ID
# containers / AZRAIL_SANDBOX
# cron triggers
# production GITHUB_TOKEN / GITHUB_REPO
# AZRAIL_TOKEN must be added as a staging Wrangler secret.
