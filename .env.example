# Секреты и обязательные переменные AZRAIL. Этот файл — только образец:
# реальные значения задаются через `wrangler secret put <ИМЯ>`, а не через
# .dev.vars или commit. Каждое имя ниже объявлено в src/types.ts (Env) —
# это проверяет tests/regressions.test.ts, чтобы .env.example и код не
# расходились в списке переменных.

# Bearer-токен для защищённых эндпоинтов (/api/task, /api/upload, /api/agents,
# /api/projects/*, /api/mission). Без него все они отвечают 503 (fail-closed).
# wrangler secret put AZRAIL_TOKEN
AZRAIL_TOKEN=changeme

# Разрешённый Origin для CORS. "*" — открыто всем; в проде указать конкретный
# хост. Обычная переменная, не секрет — совпадает со значением в wrangler.toml.
CORS_ORIGIN=*

# Лимит задач в час на вызывающего (KV-бакет). По умолчанию 50.
AZRAIL_HOURLY_LIMIT=50

# GitHub Personal Access Token с правами repo. Нужен Git Agent для
# commit_file/open_pr/diff/list_commits и Deploy Agent для триггера CI.
# wrangler secret put GITHUB_TOKEN
GITHUB_TOKEN=ghp_your-token-here

# owner/name репозитория по умолчанию — фоллбек, если gitRepo не передан
# в теле запроса явно.
# wrangler secret put GITHUB_REPO
GITHUB_REPO=owner/name
