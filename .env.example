# Unified production: OIDC + server cookies. Example names, not live secrets.
# Deploy variables are described in DEPLOY_RU.md. Never commit real values.
AUTH_MODE=oidc
PUBLIC_ORIGINS=https://mnmllpulse.com,https://mnmllpulse.org,https://pulse-labs.org
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Secret, only for confidential OIDC clients with client_secret_post:
OIDC_CLIENT_SECRET=
OPERATOR_ACCOUNT_IDS=
AI_GATEWAY_ID=default
DAILY_PROVIDER_CALLS=200

# MCP allowlist, registered OAuth clients and daily operation caps.
# Empty catalog disables connector creation. See docs/CONNECTORS_RU.md.
MCP_SERVERS=[]
# Secrets: retain this vault key across deployments. 32 random bytes in base64.
INTEGRATION_KEY=
# JSON mapping of policy ID to a confidential client's secret; never in MCP_SERVERS.
MCP_OAUTH_SECRETS={}

# Legacy bearer mode only; unused as a login method when AUTH_MODE=oidc.
# These values remain documented for the original AZRAIL engine.
AZRAIL_TOKEN=
CORS_ORIGIN=https://mnmllpulse.com
AZRAIL_HOURLY_LIMIT=50
# Optional old engine Git Agent integration; grants server-side project actions.
GITHUB_TOKEN=
GITHUB_REPO=

# Read-only post-deployment smoke checks. For AUTH_MODE=oidc use a live
# session cookie from your own login; token mode can use AZRAIL_TOKEN.
# Supply at runtime, never commit a real cookie.
# OIDC smoke runtime variable: AZRAIL_SESSION_COOKIE
