# Секреты задаются через `wrangler secret put <NAME>` (или Dashboard → Settings → Variables),
# не через .env — Workers не читает .env в проде. Файл — просто чек-лист.

# ОБЯЗАТЕЛЬНО перед деплоем. Без него /api/task и остальные платные
# эндпоинты закрыты (fail-closed) — это защита от того, чтобы посторонний
# с публичным URL тратил твой бюджет на Workers AI.
#   wrangler secret put AZRAIL_TOKEN
# Значение — любая длинная случайная строка, например:
#   openssl rand -hex 32
AZRAIL_TOKEN=

# Необязательно: лимит задач в час (по умолчанию 50).
# Задаётся как обычная переменная, не секрет.
AZRAIL_HOURLY_LIMIT=

# Опционально: GitHub token с правом repository_dispatch, если Deploy Agent
# должен сам триггерить твой существующий CI-пайплайн (GitHub → Workers Builds).
GITHUB_TOKEN=
GITHUB_REPO=owner/name

# Ограничение источника для CORS. По умолчанию "*" — для публичного
# интерфейса это нормально, API всё равно закрыт токеном. Сузить стоит,
# если воркер будет дёргать только твой домен.
CORS_ORIGIN=

# Потолок операций записи в час (по умолчанию 5000). Защита от того, что
# зациклившийся код нагенерирует счёт: Cloudflare берёт деньги за каждую
# запись и НЕ ДАЁТ поставить лимит расходов — узнают по счёту.
# Нормальная миссия укладывается в 60 записей.
AZRAIL_WRITE_BUDGET=

# ─────────────────────────────────────────────────────────────────────
# ЧЕГО ЗДЕСЬ БОЛЬШЕ НЕТ И ПОЧЕМУ
#
# Раньше файл предлагал задать OPENAI_API_KEY и ANTHROPIC_API_KEY.
# Код их НЕ ЧИТАЕТ — ни одного обращения во всём src/. Задав их, ты бы
# ничего не изменил и не смог понять почему: переменная есть, эффекта нет.
#
# Сторонние модели идут через AI Gateway: ключи хранятся на стороне
# шлюза, в воркер не попадают. Настраивается в Dashboard → AI → AI Gateway,
# имя шлюза должно совпасть с AI_GATEWAY_ID в wrangler.toml.
# ─────────────────────────────────────────────────────────────────────
